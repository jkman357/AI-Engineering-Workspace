<Window x:Class="AIEngineeringWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Engineering Workspace — v0.0.6rc06"
        Width="1700"
        Height="960"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#B8B8B8" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="AI Engineering Workspace" />
                    <TextBlock Margin="10,3,0,0" Text="v0.0.6rc06 — Native Shell + Git Status + Resize Reliability" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="38" Height="30" Margin="0,0,6,0" Click="AddFilePaneButton_Click" ToolTip="Add File pane">
                        <TextBlock FontSize="16" Text="📁+" />
                    </Button>
                    <Button Width="38" Height="30" Margin="0,0,6,0" Click="AddBrowserPaneButton_Click" ToolTip="Add Browser pane">
                        <TextBlock FontSize="16" Text="🌐+" />
                    </Button>
                    <Button x:Name="LayoutModeButton" Width="38" Height="30" Margin="0,0,6,0" Click="LayoutModeButton_Click" ToolTip="Auto Fit layout is ON. Click to use Free Layout.">
                        <TextBlock x:Name="LayoutModeGlyph" FontSize="17" FontWeight="Bold" Text="▦" />
                    </Button>
                    <Button x:Name="ShowIdsButton" Width="38" Height="30" Margin="0,0,6,0" Click="ShowIdsButton_Click" ToolTip="Show routing endpoint IDs (B1-B8 / F1-F4)">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="#" />
                    </Button>
                    <Button Width="38" Height="30" Click="DetachAllButton_Click" ToolTip="Detach all docked Firefox windows">
                        <TextBlock FontSize="17" Text="↗" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WorkspaceStatusTextBlock"
                           Grid.Column="0"
                           Text="Ready." />
                <TextBlock x:Name="PaneCountTextBlock"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           Text="Standard user / API-free" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Margin="4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top"
                      CanContentScroll="False">
            <Canvas x:Name="WorkspaceCanvas"
                    Width="1200"
                    Height="700"
                    MinWidth="900"
                    MinHeight="560"
                    Background="#F7F7F7" />
        </ScrollViewer>
    </DockPanel>
</Window>
