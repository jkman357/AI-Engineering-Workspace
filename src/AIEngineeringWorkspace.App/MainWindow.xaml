<Window x:Class="AIEngineeringWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Engineering Workspace — v0.0.5rc01"
        Width="1700"
        Height="960"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#B8B8B8" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="AI Engineering Workspace" />
                    <TextBlock Margin="10,3,0,0" Text="v0.0.5rc01 — Unified Dynamic Pane + Endpoint Identity POC" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Padding="12,6" Click="AddFilePaneButton_Click">+ Files</Button>
                    <Button Margin="0,0,6,0" Padding="12,6" Click="AddBrowserPaneButton_Click">+ Browser</Button>
                    <Button x:Name="ShowIdsButton" Margin="0,0,6,0" Padding="12,6" Click="ShowIdsButton_Click">Show IDs</Button>
                    <Button Padding="14,6" Click="DetachAllButton_Click">Detach All</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#B8B8B8" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WorkspaceStatusTextBlock"
                           Grid.Column="0"
                           Text="Ready." />
                <TextBlock x:Name="PaneCountTextBlock"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           Text="Standard user / API-free" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Margin="8"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <Canvas x:Name="WorkspaceCanvas"
                    Width="1580"
                    Height="820"
                    MinWidth="1200"
                    MinHeight="700"
                    Background="#F7F7F7" />
        </ScrollViewer>
    </DockPanel>
</Window>
