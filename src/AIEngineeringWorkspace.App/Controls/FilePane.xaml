<UserControl x:Class="AIEngineeringWorkspace.Controls.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300"
             MinHeight="240"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Border BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="2" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#C9C9C9" BorderThickness="0,0,0,1" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Thumb x:Name="MoveThumb"
                           Grid.Row="0"
                           Grid.Column="0"
                           Width="24"
                           Height="23"
                           Margin="0,0,6,5"
                           Cursor="SizeAll"
                           DragStarted="MoveThumb_DragStarted"
                           DragDelta="MoveThumb_DragDelta"
                           DragCompleted="MoveThumb_DragCompleted"
                           ToolTip="Drag to move this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" Text="⋮⋮" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <TextBlock x:Name="PaneTitleTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,7,5"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Files" />

                    <Border x:Name="EndpointBadgeBorder"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,7,5"
                            Padding="6,2"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#FFFFFF"
                            Visibility="Collapsed">
                        <TextBlock x:Name="EndpointBadgeTextBlock"
                                   FontWeight="Bold"
                                   Text="F1" />
                    </Border>

                    <TextBox x:Name="PathTextBox"
                             Grid.Row="0"
                             Grid.Column="3"
                             Margin="0,0,5,5"
                             MinWidth="120"
                             VerticalContentAlignment="Center"
                             KeyDown="PathTextBox_KeyDown" />

                    <Button Grid.Row="0" Grid.Column="4" Margin="0,0,4,5" Padding="8,3" Click="GoButton_Click">Go</Button>
                    <Button Grid.Row="0" Grid.Column="5" Margin="0,0,4,5" Padding="8,3" Click="UpButton_Click" ToolTip="Parent folder">↑</Button>
                    <Button Grid.Row="0" Grid.Column="6" Margin="0,0,4,5" Padding="8,3" Click="RefreshButton_Click" ToolTip="Refresh">↻</Button>
                    <Button Grid.Row="0" Grid.Column="7" Width="24" Height="23" Margin="0,0,0,5" Padding="0" FontWeight="Bold" Click="ClosePaneButton_Click" ToolTip="Close this file pane">×</Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="8"
                               Foreground="#666666"
                               FontSize="11"
                               Text="Double-click folders to open. Drag files to a browser pane." />
                </Grid>
            </Border>

            <ListView x:Name="FileListView"
                      Grid.Row="1"
                      BorderThickness="0"
                      SelectionMode="Single"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FileListView_PreviewMouseMove">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="Name" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="16" Height="16" Margin="0,0,6,0" Source="{Binding Icon}" SnapsToDevicePixels="True" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Modified" Width="125" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PaneStatusTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Ready."
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Ready." />
                    <Thumb x:Name="ResizeThumb"
                           Grid.Column="1"
                           Width="18"
                           Height="18"
                           Margin="6,0,0,0"
                           Cursor="SizeNWSE"
                           DragDelta="ResizeThumb_DragDelta"
                           ToolTip="Drag to resize this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#555555" Text="◢" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
