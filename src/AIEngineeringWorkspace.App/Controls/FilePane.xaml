<UserControl x:Class="AIEngineeringWorkspace.Controls.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300"
             MinHeight="240"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Border Margin="5" BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="2" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#C9C9C9" BorderThickness="0,0,0,1" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Thumb x:Name="MoveThumb"
                           Grid.Row="0"
                           Grid.Column="0"
                           Width="24"
                           Height="23"
                           Margin="0,0,6,5"
                           Cursor="SizeAll"
                           DragStarted="MoveThumb_DragStarted"
                           DragDelta="MoveThumb_DragDelta"
                           DragCompleted="MoveThumb_DragCompleted"
                           ToolTip="Drag to move this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" Text="⋮⋮" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <TextBlock x:Name="PaneTitleTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,7,5"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Files" />

                    <Border x:Name="EndpointBadgeBorder"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,7,5"
                            Padding="6,2"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#FFFFFF"
                            Visibility="Collapsed">
                        <TextBlock x:Name="EndpointBadgeTextBlock"
                                   FontWeight="Bold"
                                   Text="F1" />
                    </Border>

                    <TextBox x:Name="PathTextBox"
                             Grid.Row="0"
                             Grid.Column="3"
                             Margin="0,0,5,5"
                             MinWidth="120"
                             VerticalContentAlignment="Center"
                             KeyDown="PathTextBox_KeyDown" />

                    <Button Grid.Row="0" Grid.Column="4" Margin="0,0,4,5" Padding="8,3" Click="GoButton_Click">Go</Button>
                    <Button Grid.Row="0" Grid.Column="5" Margin="0,0,4,5" Padding="8,3" Click="UpButton_Click" ToolTip="Parent folder">↑</Button>
                    <Button Grid.Row="0" Grid.Column="6" Margin="0,0,4,5" Padding="8,3" Click="RefreshButton_Click" ToolTip="Refresh">↻</Button>
                    <Button Grid.Row="0" Grid.Column="7" Width="24" Height="23" Margin="0,0,0,5" Padding="0" FontWeight="Bold" Click="ClosePaneButton_Click" ToolTip="Close this file pane">×</Button>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="8"
                               Foreground="#666666"
                               FontSize="11"
                               Text="Double-click folders to open. Native right-click menu; Git badges show repository / working-tree state." />
                </Grid>
            </Border>

            <ListView x:Name="FileListView"
                      Grid.Row="1"
                      BorderThickness="0"
                      SelectionMode="Single"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="FileListView_PreviewMouseRightButtonDown"
                      PreviewMouseRightButtonUp="FileListView_PreviewMouseRightButtonUp"
                      PreviewMouseMove="FileListView_PreviewMouseMove"
                      PreviewKeyDown="FileListView_PreviewKeyDown">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Width="190">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader x:Name="NameColumnHeader" Tag="Name" Content="Name ↑" Click="GridViewColumnHeader_Click" ToolTip="Sort by name" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18" Margin="0,0,4,0">
                                            <Image Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Icon}" SnapsToDevicePixels="True" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="12" Height="12" Padding="1,0" Background="#FFFFFF" BorderBrush="#666666" BorderThickness="1" CornerRadius="2" ToolTip="{Binding GitTooltip}"><TextBlock FontSize="9" FontWeight="Bold" LineHeight="9" TextAlignment="Center" Text="{Binding GitGlyph}" Foreground="#111111" /></Border>
                                        </Grid>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="70" DisplayMemberBinding="{Binding Type}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader x:Name="TypeColumnHeader" Tag="Type" Content="Type" Click="GridViewColumnHeader_Click" ToolTip="Sort by type" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="80" DisplayMemberBinding="{Binding SizeText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader x:Name="SizeColumnHeader" Tag="Size" Content="Size" Click="GridViewColumnHeader_Click" ToolTip="Sort by size" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="125" DisplayMemberBinding="{Binding ModifiedText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader x:Name="ModifiedColumnHeader" Tag="Modified" Content="Modified" Click="GridViewColumnHeader_Click" ToolTip="Sort by modified time" />
                            </GridViewColumn.Header>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PaneStatusTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Ready."
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Ready." />
                </Grid>
            </Border>
        </Grid>
        </Border>

        <Grid x:Name="ResizeChrome" Panel.ZIndex="999">
            <Grid.Resources>
                <Style TargetType="{x:Type Thumb}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Thumb Tag="Left" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="14" Margin="0,18,0,18" Cursor="SizeWE" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag left edge to resize" />
            <Thumb Tag="Right" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="14" Margin="0,18,0,18" Cursor="SizeWE" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag right edge to resize" />
            <Thumb Tag="Top" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="14" Margin="18,0,18,0" Cursor="SizeNS" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag top edge to resize" />
            <Thumb Tag="Bottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="14" Margin="18,0,18,0" Cursor="SizeNS" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag bottom edge to resize" />

            <Thumb Tag="TopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" Height="20" Cursor="SizeNWSE" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag top-left corner to resize" />
            <Thumb Tag="TopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Cursor="SizeNESW" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag top-right corner to resize" />
            <Thumb Tag="BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNESW" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag bottom-left corner to resize" />
            <Thumb Tag="BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNWSE" DragDelta="PaneBorderResize_DragDelta" ToolTip="Drag bottom-right corner to resize" />
        </Grid>
    </Grid>
</UserControl>
