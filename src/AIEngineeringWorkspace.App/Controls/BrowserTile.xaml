<UserControl x:Class="AIEngineeringWorkspace.Controls.BrowserTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="260"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             SizeChanged="UserControl_SizeChanged">
    <Border BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="2" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#C9C9C9" BorderThickness="0,0,0,1" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Thumb x:Name="MoveThumb"
                           Grid.Row="0"
                           Grid.Column="0"
                           Width="24"
                           Height="23"
                           Margin="0,0,6,5"
                           Cursor="SizeAll"
                           DragStarted="MoveThumb_DragStarted"
                           DragDelta="MoveThumb_DragDelta"
                           DragCompleted="MoveThumb_DragCompleted"
                           ToolTip="Drag to move this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" Text="⋮⋮" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <TextBlock x:Name="TileTitleTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,7,5"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Browser" />

                    <Border x:Name="EndpointBadgeBorder"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,7,5"
                            Padding="6,2"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#FFFFFF"
                            Visibility="Collapsed">
                        <TextBlock x:Name="EndpointBadgeTextBlock"
                                   FontWeight="Bold"
                                   Text="B1" />
                    </Border>

                    <TextBox x:Name="UrlTextBox"
                             Grid.Row="0"
                             Grid.Column="3"
                             Margin="0,0,6,5"
                             MinWidth="160"
                             VerticalContentAlignment="Center"
                             KeyDown="UrlTextBox_KeyDown"
                             ToolTip="Enter a URL and press Enter to navigate this Browser pane"
                             Text="https://www.google.com/" />
                    <Button x:Name="MaximizePaneButton"
                            Grid.Row="0"
                            Grid.Column="4"
                            Width="24"
                            Height="23"
                            Margin="0,0,4,5"
                            Padding="0"
                            FontWeight="Bold"
                            Click="MaximizePaneButton_Click"
                            ToolTip="Maximize this Browser pane inside the Workspace">□</Button>
                    <Button x:Name="ClosePaneButton"
                            Grid.Row="0"
                            Grid.Column="5"
                            Width="24"
                            Height="23"
                            Margin="0,0,0,5"
                            Padding="0"
                            FontWeight="Bold"
                            Click="ClosePaneButton_Click"
                            ToolTip="Close this browser pane">×</Button>

                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6">
                        <Button x:Name="LaunchButton" Margin="0,0,6,0" Padding="10,4" Click="LaunchButton_Click">Launch + Dock</Button>
                        <Button x:Name="DockExistingButton" Margin="0,0,6,0" Padding="10,4" Click="DockExistingButton_Click">Dock Existing</Button>
                        <Button x:Name="FocusButton" Margin="0,0,6,0" Padding="10,4" Click="FocusButton_Click">Focus</Button>
                        <Button x:Name="DetachButton" Padding="10,4" Click="DetachButton_Click">Detach</Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <controls:BrowserDockHost xmlns:controls="clr-namespace:AIEngineeringWorkspace.Controls" x:Name="BrowserHost" Grid.Row="1" />

            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TileStatusTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Ready."
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Ready." />
                    <Thumb x:Name="ResizeThumb"
                           Grid.Column="1"
                           Width="18"
                           Height="18"
                           Margin="6,0,0,0"
                           Cursor="SizeNWSE"
                           DragDelta="ResizeThumb_DragDelta"
                           ToolTip="Drag to resize this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#555555" Text="◢" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
