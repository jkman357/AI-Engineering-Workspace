<UserControl x:Class="AIEngineeringWorkspace.Controls.BrowserTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="360"
             MinHeight="260"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             SizeChanged="UserControl_SizeChanged">
    <Grid>
        <Border x:Name="PaneFrameBorder" Margin="5" BorderBrush="#8A8A8A" BorderThickness="1" CornerRadius="2" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F3F3F3" BorderBrush="#C9C9C9" BorderThickness="0,0,0,1" Padding="7">
                <StackPanel>
                    <Border x:Name="EndpointLargeBadgeBorder"
                            Width="64"
                            Height="64"
                            Margin="0,0,0,7"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            BorderThickness="3"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="EndpointLargeBadgeTextBlock"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Text="B1" />
                    </Border>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Thumb x:Name="MoveThumb"
                           Grid.Row="0"
                           Grid.Column="0"
                           Width="24"
                           Height="23"
                           Margin="0,0,6,5"
                           Cursor="SizeAll"
                           DragStarted="MoveThumb_DragStarted"
                           DragDelta="MoveThumb_DragDelta"
                           DragCompleted="MoveThumb_DragCompleted"
                           ToolTip="Drag to move this pane">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1" Background="#E7E7E7" CornerRadius="2">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#555555" Text="⋮⋮" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <TextBlock x:Name="TileTitleTextBlock"
                               Visibility="Collapsed"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,7,5"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Browser" />

                    <Border x:Name="EndpointBadgeBorder"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,7,5"
                            MinWidth="40"
                            Padding="8,3"
                            BorderBrush="#777777"
                            BorderThickness="2"
                            CornerRadius="4"
                            Background="#FFFFFF"
                            Visibility="Visible">
                        <TextBlock x:Name="EndpointBadgeTextBlock"
                                   FontWeight="Bold"
                                   Text="B1" />
                    </Border>

                    <Border Grid.Row="0" Grid.Column="3" />
                    <Button x:Name="MaximizePaneButton"
                            Grid.Row="0"
                            Grid.Column="4"
                            Width="24"
                            Height="23"
                            Margin="0,0,4,5"
                            Padding="0"
                            FontWeight="Bold"
                            Click="MaximizePaneButton_Click"
                            ToolTip="Maximize this Browser pane inside the Workspace">□</Button>
                    <Button x:Name="ClosePaneButton"
                            Grid.Row="0"
                            Grid.Column="5"
                            Width="24"
                            Height="23"
                            Margin="0,0,0,5"
                            Padding="0"
                            FontWeight="Bold"
                            Click="ClosePaneButton_Click"
                            ToolTip="Close this browser pane">×</Button>

                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6">
                        <Button x:Name="LaunchButton"
                                Width="32"
                                Height="28"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontSize="16"
                                Click="LaunchButton_Click"
                                ToolTip="Launch a new Firefox window and dock it into this Browser pane">▶</Button>
                        <Button x:Name="DockExistingButton"
                                Width="32"
                                Height="28"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontSize="17"
                                Click="DockExistingButton_Click"
                                ToolTip="Dock the single existing Firefox window into this Browser pane">⇲</Button>
                        <Button x:Name="FocusButton"
                                Width="32"
                                Height="28"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontSize="17"
                                Click="FocusButton_Click"
                                ToolTip="Recover keyboard focus to the docked Firefox web-content area">⌖</Button>
                        <Button x:Name="DetachButton"
                                Width="32"
                                Height="28"
                                Padding="0"
                                FontSize="17"
                                Click="DetachButton_Click"
                                ToolTip="Detach and restore this Firefox window">↗</Button>
                    </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <controls:BrowserDockHost xmlns:controls="clr-namespace:AIEngineeringWorkspace.Controls" x:Name="BrowserHost" Grid.Row="1" />

            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TileStatusTextBlock"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Ready."
                               TextTrimming="CharacterEllipsis"
                               ToolTip="Ready." />
                </Grid>
            </Border>
        </Grid>
        </Border>

        <Grid x:Name="ResizeChrome" Panel.ZIndex="999">
            <Grid.Resources>
                <Style TargetType="{x:Type Thumb}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Thumb Tag="Left" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="14" Margin="0,18,0,18" Cursor="SizeWE" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag left edge to resize" />
            <Thumb Tag="Right" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="14" Margin="0,18,0,18" Cursor="SizeWE" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag right edge to resize" />
            <Thumb Tag="Top" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="14" Margin="18,0,18,0" Cursor="SizeNS" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag top edge to resize" />
            <Thumb Tag="Bottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="14" Margin="18,0,18,0" Cursor="SizeNS" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag bottom edge to resize" />

            <Thumb Tag="TopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" Height="20" Cursor="SizeNWSE" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag top-left corner to resize" />
            <Thumb Tag="TopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Cursor="SizeNESW" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag top-right corner to resize" />
            <Thumb Tag="BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNESW" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag bottom-left corner to resize" />
            <Thumb Tag="BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNWSE" DragDelta="PaneBorderResize_DragDelta" DragCompleted="PaneBorderResize_DragCompleted" ToolTip="Drag bottom-right corner to resize" />
        </Grid>
    </Grid>
</UserControl>
